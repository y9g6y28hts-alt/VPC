{
  "name": "motor-haus",
  "version": "0.1.0",
  "private": true,
  "description": "Motor Haus \u2014 sistema operativo privado para concesionaria de veh\u00edculos y activos de lujo",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/integration",
    "db:reset": "bash scripts/db-reset.sh",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "e2e": "tsx --env-file=.env scripts/e2e-smoke.ts",
    "crawl": "tsx --env-file=.env scripts/crawl.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/db-setup.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "decimal.js": "10.6.0",
    "geist": "1.8.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
