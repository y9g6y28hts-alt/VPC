# =============================================================================
# Da Silva OS — variables de entorno
# Copie este archivo a .env.local (desarrollo) o configúrelas en su hosting.
# =============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
# URL del proyecto y clave pública (anon / publishable). Son públicas por diseño.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clave-anon>

# --- Sólo servidor (NUNCA con prefijo NEXT_PUBLIC_) ---------------------------
# Conexión a PostgreSQL. En Supabase: Project Settings → Database → Connection
# string → "Transaction pooler" (puerto 6543). La app opera con SET ROLE
# authenticated + claims del usuario, por lo que RLS aplica en cada consulta.
DATABASE_URL=postgres://postgres.<proyecto>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Clave service_role: sólo para invitar/administrar usuarios desde Configuración.
SUPABASE_SERVICE_ROLE_KEY=<clave-service-role>

# Almacenamiento de documentos: "supabase" (producción) o "local" (sólo desarrollo).
STORAGE_MODE=supabase
