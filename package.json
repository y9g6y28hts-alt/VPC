{
  "name": "da-silva-os",
  "version": "0.1.0",
  "private": true,
  "description": "Da Silva OS — sistema operativo privado de Da Silva Automotores",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/bundle-sql.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
