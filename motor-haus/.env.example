# --- Base de datos -----------------------------------------------------------
# Conexión del servidor Next.js. El rol NO debe tener privilegios propios:
# el gateway ejecuta SET LOCAL ROLE authenticated en cada transacción (RLS).
# En Supabase: cadena de conexión directa (Session pooler) del rol postgres.
# MH_DATABASE_URL tiene prioridad sobre DATABASE_URL (útil en Vercel + Neon).
DATABASE_URL=postgres://mh_app:mh_app_local_only@127.0.0.1:5432/motor_haus
# Solo para seed y pruebas locales (superusuario local). Nunca en producción.
MH_ADMIN_DATABASE_URL=postgres://mh_admin:mh_admin_local_only@127.0.0.1:5432/motor_haus

# --- Autenticación -----------------------------------------------------------
# supabase: Supabase Auth (producción) · local: credenciales en auth.users local
MH_AUTH_MODE=local
# Secreto para firmar la cookie de sesión en modo local (mínimo 32 caracteres).
MH_SESSION_SECRET=change-me-local-development-secret-32+
# Modo supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zona horaria de negocio para fechas por defecto en la interfaz
MH_TIMEZONE=America/Asuncion
